subsection Boundary temperature model
  set List of model names                   = initial temperature
  set Fixed temperature boundary indicators = bottom
end

subsection Initial temperature model
  set List of model names = adiabatic, function

  subsection Function
    set Variable names      = x, y
    set Function constants  = x0={x0-plume}, y0={y0-plume}, dx={dx-plume}, dy={dy-plume}, L={l-plume}, W={w-plume}, dT={dt-anomaly}, A={a-plume}
    set Function expression = dT * exp(-(((x-x0)*(-dy)+(y-y0)*dx)/L)^2/(2*W^2)) * 0.5*(1+tanh((L-((x-x0)*dx+(y-y0)*dy)/L)/A))
  end
end
