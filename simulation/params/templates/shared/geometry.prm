subsection Geometry model
  set Model name = box

  subsection Box
    set X extent      = {model-width}
    set Y extent      = {model-height}
    set X repetitions = {mesh-x}
    set Y repetitions = {mesh-y}
  end
end

subsection Mesh refinement
  set Initial adaptive refinement        = {mesh-refine-adapt}
  set Initial global refinement          = {mesh-refine-global}
  set Time steps between mesh refinement = {mesh-refine-tstep}
end
