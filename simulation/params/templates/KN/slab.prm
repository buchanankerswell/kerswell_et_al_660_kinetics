# This cookbook illustrates the effects of growth kinetics on the olivine --> wadsleyite phase transition
# and diffusion-controlled kinetics on the ringwoodite --> postspinel phase transition.
# It features a simplified thermal slab, induced by cold material entering the model with a prescribed temperature.

set Output directory = results/slab_{uid}

include configs/{uid}/globals.prm
include configs/{uid}/solver.prm
include configs/{uid}/geometry.prm
include configs/{uid}/velocity-slab.prm
include configs/{uid}/composition.prm
include configs/{uid}/temperature-slab.prm
include params/static/heating.prm
include params/static/traction-slab.prm
include params/static/gravity.prm
include params/static/adiabat.prm
include configs/{uid}/material.prm
include configs/{uid}/postprocess.prm
